        </Key>
        <Key ID="STR_RTZ_Casualty_MsgZonePlaced">
            <English>Medical Zone Placed — %1 [m]</English>
        </Key>
        <Key ID="STR_RTZ_Casualty_MsgZoneRemoved">
            <English>Medical zone removed</English>
        </Key>
        <Key ID="STR_RTZ_Casualty_SurvivalChance">
            <English>Survival Chance</English>
        </Key>
        <Key ID="STR_RTZ_Casualty_SurvivalChance_Description">
            <English>The chance that a lethal hit on a unit downs him as a casualty instead of killing him.</English>
        </Key>
