        <Key ID="STR_RTZ_Supply_MsgSupplyLinesShown">
            <English>Supply Lines Shown</English>
        </Key>
        <Key ID="STR_RTZ_Supply_ServiceDuration">
            <English>Service Duration</English>
        </Key>
        <Key ID="STR_RTZ_Supply_ServiceDuration_Description">
            <English>Time in seconds a supply vehicle takes to fully repair, refuel and rearm the vehicles around it.</English>
        </Key>
        <Key ID="STR_RTZ_Supply_ServiceInterval">
            <English>Service Update Interval</English>
        </Key>
        <Key ID="STR_RTZ_Supply_ServiceInterval_Description">
            <English>Seconds between service progress updates. Only changes how often repair and fuel are written — total service time is set by the duration setting. Applies to newly started orders.</English>
        </Key>
        <Key ID="STR_RTZ_Supply_ServiceRadius">
            <English>Service Radius</English>
        </Key>
        <Key ID="STR_RTZ_Supply_ServiceRadius_Description">
            <English>Distance in meters within which a supply vehicle can service other vehicles. Vehicles that leave this range mid-service keep whatever they were given.</English>
        </Key>
        <Key ID="STR_RTZ_Supply_SupplyDisplay">
            <English>Supply Lines Overlay</English>
        </Key>
        <Key ID="STR_RTZ_Supply_SupplyDisplay_Description">
            <English>Enable the Show Supply Lines Zeus context menu action, which draws a line from each selected supply vehicle to every vehicle it is currently servicing.</English>
        </Key>
