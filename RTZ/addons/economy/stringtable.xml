<?xml version="1.0" encoding="utf-8"?>
<Project name="RTZ">
    <Package name="Economy">
        <Key ID="STR_RTZ_Economy_DeleteRefund">
            <English>Refund Coefficient</English>
        </Key>
        <Key ID="STR_RTZ_Economy_DeleteRefund_Description">
            <English>The percentage of an object's cost refunded when it is deleted. Note that deleting corpses and wrecks also refunds.</English>
        </Key>
        <Key ID="STR_RTZ_Economy_DisplayName">
            <English>Economy</English>
        </Key>
        <Key ID="STR_RTZ_Economy_Enable">
            <English>Enable Economy</English>
        </Key>
        <Key ID="STR_RTZ_Economy_Enable_Description">
            <English>Placing units, vehicles and static weapons costs curator points, shown as the resource bar in the Zeus interface. When disabled, everything is free. Costs refresh when the Zeus interface is reopened.</English>
        </Key>
        <Key ID="STR_RTZ_Economy_Income">
            <English>Income</English>
        </Key>
        <Key ID="STR_RTZ_Economy_IncomeInterval">
            <English>Income Interval</English>
        </Key>
        <Key ID="STR_RTZ_Economy_IncomeInterval_Description">
            <English>How often income is paid out, in seconds. Lower values give smoother, more frequent payouts.</English>
        </Key>
        <Key ID="STR_RTZ_Economy_Income_Description">
            <English>Points gained per minute.</English>
        </Key>
        <Key ID="STR_RTZ_Economy_PlacementToast">
            <English>Cost Feedback</English>
        </Key>
        <Key ID="STR_RTZ_Economy_PlacementToast_Description">
            <English>Show a Zeus feedback message with the point cost of the selected asset when choosing something to place.</English>
        </Key>
    </Package>
</Project>
