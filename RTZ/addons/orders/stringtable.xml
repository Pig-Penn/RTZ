<?xml version="1.0" encoding="utf-8"?>
<Project name="RTZ">
    <Package name="Orders">
        <Key ID="STR_RTZ_Orders_CameraToCursor">
            <English>Camera to Cursor</English>
        </Key>
        <Key ID="STR_RTZ_Orders_CameraToCursor_Description">
            <English>Teleport the Zeus camera to the position under the map cursor. Works inside curator editing areas, where the native middle-click map teleport is blocked.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_DisplayName">
            <English>Orders</English>
        </Key>
        <Key ID="STR_RTZ_Orders_HeliHeightDown">
            <English>Decrease Altitude</English>
        </Key>
        <Key ID="STR_RTZ_Orders_HeliHeightDown_Description">
            <English>Lower the selected aircraft's altitude by the step setting.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_HeliHeightStep">
            <English>Altitude Step</English>
        </Key>
        <Key ID="STR_RTZ_Orders_HeliHeightStep_Description">
            <English>Metres the fly-height keybinds add or subtract per press.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_HeliHeightUp">
            <English>Increase Altitude</English>
        </Key>
        <Key ID="STR_RTZ_Orders_HeliHeightUp_Description">
            <English>Raise the selected aircraft's altitude by the step setting.</English>
        </Key>
