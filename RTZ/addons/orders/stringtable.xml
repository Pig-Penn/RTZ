        </Key>
        <Key ID="STR_RTZ_Orders_MsgNoUnitSelected">
            <English>No unit selected</English>
        </Key>
        <Key ID="STR_RTZ_Orders_MsgOpenFireCount">
            <English>Open Fire x%1</English>
        </Key>
        <Key ID="STR_RTZ_Orders_MsgTeleported">
            <English>Teleported</English>
        </Key>
        <Key ID="STR_RTZ_Orders_OpenUnitInventory">
            <English>Open Inventory</English>
        </Key>
        <Key ID="STR_RTZ_Orders_OpenUnitInventory_Description">
            <English>Open the selected unit's inventory to loot nearby crates, vehicles, or bodies.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_StanceAuto">
            <English>Stance Auto</English>
        </Key>
        <Key ID="STR_RTZ_Orders_StanceAuto_Description">
            <English>Let the selected AI infantry choose their own stance again.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_StanceDown">
            <English>Stance Down</English>
        </Key>
        <Key ID="STR_RTZ_Orders_StanceDown_Description">
            <English>Set the selected AI infantry's stance to prone.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_StanceMiddle">
            <English>Stance Middle</English>
        </Key>
        <Key ID="STR_RTZ_Orders_StanceMiddle_Description">
            <English>Set the selected AI infantry's stance to crouched.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_StanceUp">
            <English>Stance Up</English>
        </Key>
        <Key ID="STR_RTZ_Orders_StanceUp_Description">
            <English>Set the selected AI infantry's stance to standing.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_TeleportCooldown">
            <English>Teleport Cooldown</English>
        </Key>
        <Key ID="STR_RTZ_Orders_TeleportCooldown_Description">
            <English>Seconds before the teleport keybind can be used again after a successful teleport. 0 disables the cooldown.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_TeleportRange">
            <English>Teleport Range</English>
        </Key>
        <Key ID="STR_RTZ_Orders_TeleportRange_Description">
            <English>Maximum distance in metres between a unit and the cursor position for the teleport keybind to move it.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_TeleportToCursor">
            <English>Teleport Units to Cursor</English>
        </Key>
        <Key ID="STR_RTZ_Orders_TeleportToCursor_Description">
            <English>Teleport the selected units to the cursor position, preserving their formation. Units in combat are skipped; the Unit Teleport settings control range and cooldown.</English>
        </Key>
        <Key ID="STR_RTZ_Orders_ToggleCombatMode">
            <English>Toggle Hold Fire</English>
        </Key>
        <Key ID="STR_RTZ_Orders_ToggleCombatMode_Description">
            <English>Flip the selected AI groups between forced Hold Fire and the standard Open Fire, maintain formation posture.</English>
        </Key>
