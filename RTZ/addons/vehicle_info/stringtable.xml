<?xml version="1.0" encoding="utf-8"?>
<Project name="RTZ">
    <Package name="Vehicle_Info">
        <Key ID="STR_RTZ_Vehicle_Info_ActionHide">
            <English>Hide Vehicle Info</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ActionShow">
            <English>Show Vehicle Info</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_Destroyed">
            <English>DESTROYED</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_DisplayName">
            <English>Vehicle Info</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_Immobile">
            <English>IMMOBILE</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_MaxDistance">
            <English>Draw Distance</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_MaxDistance_Description">
            <English>Maximum distance from the camera at which vehicle info is drawn.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_RemoveOnDestroyed">
            <English>Remove on Destruction</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_RemoveOnDestroyed_Description">
            <English>Stop tracking vehicles when they are destroyed instead of showing a DESTROYED marker.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_Scale">
            <English>Size</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_Scale_Description">
            <English>Overall size of the bars and info text.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowAmmo">
            <English>Show Ammo Bar</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowAmmo_Description">
            <English>Display a bar showing the remaining ammunition in the current magazine of the vehicle's primary armed turret. Hidden for unarmed vehicles.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowCrew">
            <English>Show Crew Count</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowCrew_Description">
            <English>Display the number of alive occupants and total seats, e.g. 3/8.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowDamage">
            <English>Show Damage Tags</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowDamage_Description">
            <English>Display red tags below the bars when critical components (engine, fuel tank, gun, tracks, wheels) are heavily damaged or the vehicle is immobilized.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowDistance">
            <English>Show Distance</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowDistance_Description">
            <English>Display the distance from the Zeus camera to the vehicle.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowFuel">
            <English>Show Fuel Bar</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowFuel_Description">
            <English>Display a bar below the health bar showing the vehicle's remaining fuel. Hidden for static weapons.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowGroup">
            <English>Show Group</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowGroup_Description">
            <English>Display the group ID of the vehicle's effective commander.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowHealth">
            <English>Show Health Percentage</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowHealth_Description">
            <English>Display the vehicle's health as a percentage.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowName">
            <English>Show Name</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowName_Description">
            <English>Display the vehicle's name.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowSpeed">
            <English>Show Speed</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_ShowSpeed_Description">
            <English>Display the vehicle's current speed in km/h.</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_TagEngine">
            <English>ENGINE</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_TagFuel">
            <English>FUEL</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_TagGun">
            <English>GUN</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_TagTracks">
            <English>TRACKS</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_TagWheels">
            <English>WHEELS</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_UseSideColor">
            <English>Color Text by Side</English>
        </Key>
        <Key ID="STR_RTZ_Vehicle_Info_UseSideColor_Description">
            <English>Color the info text using the side color of the vehicle's crew.</English>
        </Key>
    </Package>
</Project>
